<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.andork</groupId>
	<artifactId>breakout</artifactId>
	<version>0.0.0-SNAPSHOT</version>
	<name>Breakout launcher</name>
	<description>displays friendly error if user is running an older version of Java, otherwise runs Breakout</description>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.3</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>2.4.2</version>
				<configuration>
					<!-- put your configurations here -->
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>org.breakout.Breakout</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>io.github.fvarrui</groupId>
				<artifactId>javapackager</artifactId>
				<version>1.7.6</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>package</goal>
						</goals>
						<configuration>
							<mainClass>org.breakout.Breakout</mainClass>
							<bundleJre>true</bundleJre>
							<runnableJar>${project.build.directory}/breakout-0.0.0-SNAPSHOT.jar</runnableJar>
							<copyDependencies>false</copyDependencies>
							<generateInstaller>true</generateInstaller>
							<administratorRequired>false</administratorRequired>
							<jrePath>${java.home}</jrePath>
							<macConfig>
								<generateDmg>true</generateDmg>
								<icnsFile>${basedir}/../breakout.icns</icnsFile>
								<customLauncher>${basedir}/nativeJavaApplicationStub</customLauncher>
							</macConfig>
							<winConfig>
								<icoFile>${basedir}/../breakout.ico</icoFile>
								<generateMsi>true</generateMsi>
							</winConfig>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>org.andork</groupId>
			<artifactId>breakout-main</artifactId>
			<version>0.0.0-SNAPSHOT</version>
  		</dependency>
	</dependencies>
</project>
